{
  "name": "convnum",
  "version": "1.0.0",
  "description": "Convert, validate, detect and format numbers across numeral systems, languages, and date formats",
  "keywords": [
    "number",
    "numeral",
    "numerical",
    "sequence",
    "ordinal",
    "convert",
    "converter",
    "conversion",
    "utility",
    "validate",
    "detect",
    "format",
    "date",
    "language",
    "transform"
  ],
  "homepage": "https://convnum.tomchen.org/",
  "bugs": {
    "url": "https://github.com/toolsu/convnum/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolsu/convnum.git"
  },
  "license": "MIT",
  "author": "Tom Chen <tomchen.org@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "unpkg": "dist/index.global.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "checkall": "bun run check && bun run typecheck && bun test",
    "check": "biome check --write src test",
    "docs:i": "cd docs && bun install",
    "docs:dev": "cd docs && bun run dev",
    "docs:build": "cd docs && bun run build",
    "docs:preview": "cd docs && bun run preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bump": "vbt"
  },
  "vbt": {
    "preBump": "bun run checkall",
    "push": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "^1.3.14",
    "tsdown": "0.22.14",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^7.0.2",
    "vbt": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
