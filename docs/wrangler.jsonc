// Deploys the built site (docs/out, from `bun run build:pages`) as a Worker with static
// assets, served at https://toolsu.com/convnum/. The files sit under out/convnum/, so the
// request path maps straight onto them.
{
  "name": "convnum",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "toolsu.com/convnum*", "zone_name": "toolsu.com" }],
  "workers_dev": false,
  "preview_urls": false
}
