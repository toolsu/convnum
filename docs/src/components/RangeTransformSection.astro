---
import { ArrowUpRight, BookOpen } from '@lucide/astro'
import RangeTransformDemo from './RangeTransformDemo.tsx'
import type { ToolLocale } from './toolI18n'

const routeLocale = Astro.locals.starlightRoute.locale
const locale: ToolLocale = routeLocale === 'zh-cn' ? 'zh-CN' : routeLocale === 'fr' ? 'fr' : 'en'
const base = routeLocale ? `/${routeLocale}` : ''

const MARKETPLACE = 'https://marketplace.visualstudio.com/items?itemName=tomchen.range-transform'
const OPEN_VSX = 'https://open-vsx.org/extension/tomchen/range-transform'
const GITHUB = 'https://github.com/toolsu/vscode-range-transform'

const text = {
  en: {
    lead: 'A VS Code extension built on convnum. Everything convnum can read becomes a range you can spread across multiple cursors, and every selection can be rewritten with a line of JavaScript. A live inline diff shows the result while you type, and the whole edit is a single undo step.',
    commands: [
      ['Insert Sequence from Range', 'each cursor gets the next item'],
      ['Transform Selections', 'one expression rewrites every selection'],
      ['Transform Selections (Advanced)', 'multi-line code in a real TypeScript editor'],
    ],
    install: 'Install from Marketplace',
    docs: 'Read the guide',
  },
  'zh-CN': {
    lead: '基于 convnum 的 VS Code 扩展。convnum 能识别的任何写法都可以作为范围，填充到多个光标；每个选区也可以用一行 JavaScript 改写。输入时会实时显示行内差异，整个修改只占一步撤销。',
    commands: [
      ['Insert Sequence from Range', '每个光标依次填入序列的下一项'],
      ['Transform Selections', '一个表达式改写所有选区'],
      ['Transform Selections (Advanced)', '在真正的 TypeScript 编辑器里写多行代码'],
    ],
    install: '从 Marketplace 安装',
    docs: '阅读使用指南',
  },
  fr: {
    lead: 'Une extension VS Code construite sur convnum. Tout ce que convnum sait lire devient une plage à répartir sur plusieurs curseurs, et chaque sélection peut être réécrite avec une ligne de JavaScript. Un diff en ligne montre le résultat pendant la saisie, et toute la modification s’annule en une seule fois.',
    commands: [
      ['Insert Sequence from Range', 'chaque curseur reçoit l’élément suivant'],
      ['Transform Selections', 'une expression réécrit chaque sélection'],
      ['Transform Selections (Advanced)', 'du code sur plusieurs lignes dans un vrai éditeur TypeScript'],
    ],
    install: 'Installer depuis le Marketplace',
    docs: 'Lire le guide',
  },
}[locale]

const examples = [['1:10', 'Mon:Fri:2', '一:十'], ['*3', 'upper', 'cn'], ['convnum.toRoman(i)']]
---

<div class="rt-x not-content">
  <div class="rt-x-copy">
    <p class="rt-x-lead">{text.lead}</p>
    <ol class="rt-x-cmds">
      {
        text.commands.map(([name, body], i) => (
          <li>
            <span class="rt-x-cmd">{name}</span>
            <span class="rt-x-cmd-body">{body}</span>
            <span class="rt-x-cmd-eg">
              {examples[i].map((eg) => (
                <code>{eg}</code>
              ))}
            </span>
          </li>
        ))
      }
    </ol>
    <div class="rt-x-actions">
      <a class="fx-btn fx-primary" href={MARKETPLACE} target="_blank" rel="noopener noreferrer">
        <span class="fx-btn-label">{text.install}</span>
        <ArrowUpRight class="fx-btn-icon" size={18} aria-hidden="true" />
      </a>
      <a class="fx-btn fx-ghost" href={`${base}/range-transform/`}>
        <BookOpen size={18} aria-hidden="true" />
        <span class="fx-btn-label">{text.docs}</span>
      </a>
      <a class="fx-link" href={OPEN_VSX} target="_blank" rel="noopener noreferrer">
        Open VSX
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
      <a class="fx-link" href={GITHUB} target="_blank" rel="noopener noreferrer">
        GitHub
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    </div>
  </div>

  <RangeTransformDemo locale={locale} client:visible />
</div>
